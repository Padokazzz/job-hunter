// Schema especulativo para Supabase PostgreSQL (Fase 2).
// Gerado a partir de prisma/schema.prisma, trocando apenas o provider/url.
// Aplicar APENAS no NOVO projeto Supabase exclusivo do Job Hunter.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Source {
  id         String         @id
  name       String
  enabled    Boolean        @default(true)
  status     String         @default("IDLE")
  lastRunAt  DateTime?
  note       String?
  jobs       Job[]
  runs       CollectionRun[]
}

model Job {
  id             String           @id @default(cuid())
  sourceId       String
  source         Source           @relation(fields: [sourceId], references: [id])
  externalId     String
  url            String
  company        String
  title          String
  description    String
  location       String
  workModel      String
  employmentType String?
  salaryMin      Int?
  salaryMax      Int?
  currency       String?
  technologies   String
  seniority      String
  english        String
  postingLanguage String?
  publishedAt    DateTime?
  firstSeenAt    DateTime         @default(now())
  dedupHash      String           @unique
  score          Int
  classification String
  matchReasons   String
  concerns       String
  status         String           @default("NEW")
  favorited      Boolean          @default(false)
  viewed         Boolean          @default(false)
  unavailable    Boolean          @default(false)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  breakdown     ScoreBreakdown[]
  applications  Application[]

  @@unique([sourceId, externalId])
  @@index([score])
  @@index([postingLanguage])
  @@index([status])
}

model ScoreBreakdown {
  id         String @id @default(cuid())
  jobId      String
  job        Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  category   String
  points     Int
  maxPoints  Int
  detail     String?
}

model CollectionRun {
  id           String   @id @default(cuid())
  sourceId     String
  source       Source   @relation(fields: [sourceId], references: [id])
  startedAt    DateTime @default(now())
  finishedAt   DateTime?
  status       String   @default("RUNNING")
  jobsFound    Int      @default(0)
  jobsNew      Int      @default(0)
  jobsRelevant Int      @default(0)
  error        String?
}

model Application {
  id              String   @id @default(cuid())
  jobId           String
  job             Job      @relation(fields: [jobId], references: [id])
  status          String   @default("PREPARED")
  appliedAt       DateTime?
  applicationUrl  String?
  channel         String?
  nextAction      String?
  followUpOn      String?
  resumeVersion   String?
  coverLetter     String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DailyReport {
  id               String   @id @default(cuid())
  date             DateTime @default(now())
  totalFound       Int
  totalRelevant    Int
  byClassification String
  topJobIds        String
  generatedAt      DateTime @default(now())
}

model Resume {
  id            String   @id @default(cuid())
  fileName      String
  originalName  String
  textContent   String
  technologies  String   // JSON array: tecnologias detectadas
  experience    String?  // JSON: experiência detectada
  education     String?  // JSON: formação detectada
  skills        String?  // JSON array: habilidades adicionais
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
