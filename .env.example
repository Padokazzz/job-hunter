# ==========================================================================
# COPIE este arquivo para `.env` e preencha os valores.
# `.env` esta no .gitignore -> NUNCA sera commitado.
# ==========================================================================

# === Dados Pessoais (OBRIGATORIO para candidaturas) ===

CANDIDATE_NAME="Seu Nome Completo"
CANDIDATE_EMAIL="seu@email.com"

# === Banco de dados ===

# Para Docker com PostgreSQL (recomendado):
# O DATABASE_URL e configurado automaticamente no docker-compose.yml
# Apenas defina a senha do PostgreSQL abaixo:

# ATENCAO: Gere uma senha forte e unica. NUNCA use o valor padrao em producao.
# Exemplo: openssl rand -base64 32
POSTGRES_PASSWORD="CHANGE_ME_STRONG_PASSWORD"

# Para uso local sem Docker (SQLite):
# DATABASE_URL="file:./dev.db"
# JOBHUNTER_DB_CONFIRMED="0"

# Para uso local com PostgreSQL externo:
# DATABASE_URL="postgresql://jobhunter:SUA_SENHA@localhost:5432/jobhunter"
# JOBHUNTER_DB_CONFIRMED="1"

# === Dashboard ===

# Porta do dashboard (default 3000)
DASHBOARD_PORT="3000"

# === Fontes de vagas ===

# --- Indeed via Bright Data MCP (RECOMENDADO) ---
# Coleta dados PUBLICOS do Indeed via MCP hospedado da Bright Data.
# Plano gratuito: 5.000 req/mes, sem cartao.
# Crie conta em brightdata.com, pegue o API token e cole aqui.
# Sem o token, o Indeed fica inativo (retorna 0).
# BRIGHTDATA_API_TOKEN="SUA_CHAVE_BRIGHTDATA"
# INDEED_DEBUG="1"

# --- Candidatura automatica (Modo 2) ---
# Auto-preparar candidaturas para vagas com score>=85 e sem risco.
# O envio continua sempre manual (humano).
# AUTO_PREPARE="1"

# === IA (opcional) ===

# Chave OpenAI para enriquecer analise (nao usado no MVP deterministico)
OPENAI_API_KEY=""
