{
  "name": "job-hunter-bot",
  "version": "0.1.0",
  "description": "Bot de busca e candidatura a vagas aderentes ao curriculo (MVP de coleta + analise + ranking)",
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "run": "tsx src/main.ts",
    "dashboard": "tsx src/dashboard/server.ts",
    "test": "tsx --test tests/*.test.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "supabase:generate": "prisma generate --schema prisma/supabase/schema.prisma",
    "supabase:push": "prisma db push --schema prisma/supabase/schema.prisma",
    "db:purge": "tsx scripts/purge.ts",
    "prisma:studio": "prisma studio"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "^1.62.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^8.0.0",
    "@prisma/client": "^5.22.0",
    "fastify": "^5.0.0",
    "pdf-parse": "^2.4.5"
  },
  "allowScripts": {
    "prisma@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true
  }
}
